n = int(input("Enter number n:"))
print("You will have to enter %d more numbers" %n)
count = 0
sum = 0
for i in range(1,n+1):
    a=int(input("Enter next number:"))
    if a % 2 == 0:
        count = count + 1
    else:
        sum = sum + a
    a = 0
print("There are %d even numbers"%count)
print("The sum of the odd numbers is %d"%sum)