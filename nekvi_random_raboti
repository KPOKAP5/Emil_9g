n = int(input("Enter number:"))
org = n
sum_factorial = 0
if n == 0:
    sum_factorial = 1
else:
    while n > 0:
        digit = n % 10
        f = 1
        for i in range(1, digit+1):
            f = f*i
        sum_factorial = sum_factorial + f
        n = n//10
if sum_factorial == org:
    print("This number is a strong number")
else:
    print("This number isn't a strong number")
    