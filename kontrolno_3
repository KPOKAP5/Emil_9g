n = str(input("Enter n"))
sum_digits = 0
palindrom = True
digits = 0
while(n<=0):
    digit = n % 10
    sum_digits = sum_digits + digit
    n = n//10
    digits = digits+1

for i in range(len(n) // 2):
    if n[i] != n[-1 - i]:
        palindrom = False
        break
    if palindrom:
        print("The number is a palindrome")
    else:
        print("The number isn't a palindrome")

while n > 0:
    swap +=(n%10)*(10**(digits-1))
    digits -= 1
    n = n//10
print(f"swap = {swap}")