n = int(input("Enter number n:"))
sum = 0
count = 0
max = 0
if n <= 0:
    print("Not valid input")
else:
    print("You will have to enter %d more numbers" %n)
    for i in range(1,n+1):
        a=int(input("Enter next number:"))
        if a % 2 == 0:
            sum = sum + a
        else:
            if max < a:
                max = a
    print("Sum of even numbers: %d"%sum)
    if max != 0:
        print("Highest odd number: %d"%max)
    else:
        print("No odd numbers")